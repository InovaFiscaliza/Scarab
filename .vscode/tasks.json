{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Scarab remoto: verificar acesso",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "set -eu; cd \"$HOME/src/scarab\"; podman --version; podman compose version; git status --short --branch"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: atualizar do origin",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "set -eu; cd \"$HOME/src/scarab\"; test -z \"$(git status --porcelain)\" || { echo 'ERRO: o checkout remoto possui alteracoes locais.' >&2; exit 1; }; git pull --ff-only"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: sincronizar alteracoes locais",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\sync-remote.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: testes unitarios Linux",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "set -eu; cd \"$HOME/src/scarab\"; podman run --rm -e UV_PROJECT_ENVIRONMENT=/tmp/venv -v \"$PWD:/workspace:ro\" --tmpfs /workspace/src/scarab.egg-info:rw --tmpfs /workspace/.pytest_cache:rw --tmpfs /workspace/build:rw -w /workspace ghcr.io/astral-sh/uv:python3.13-bookworm-slim uv run --frozen --extra dev --no-editable pytest -q"
            ],
            "dependsOn": "Scarab remoto: sincronizar alteracoes locais",
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: validar Compose",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "/usr/local/sbin/scarab-ops validate --instance scarab-test"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: subir e reconstruir",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "/usr/local/sbin/scarab-deploy update --instance scarab-test"
            ],
            "dependsOn": [
                "Scarab remoto: sincronizar alteracoes locais",
                "Scarab remoto: validar Compose"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: teste funcional",
            "type": "process",
            "command": "${workspaceFolder}\\examples\\src\\exe.bat",
            "args": [
                "--host",
                "ContainerHost",
                "--operation",
                "reset",
                "--db-host",
                "${input:scarabDbHost}",
                "--db-port",
                "${input:scarabDbPort}",
                "--confirm-reset",
                "scarab-test"
            ],
            "dependsOn": "Scarab remoto: subir e reconstruir",
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: status",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "/usr/local/sbin/scarab-ops status --instance scarab-test"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: logs",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "/usr/local/sbin/scarab-ops logs --instance scarab-test"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: parar",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "/usr/local/sbin/scarab-ops stop --instance scarab-test"
            ],
            "problemMatcher": []
        },
        {
            "label": "Scarab remoto: backup do banco",
            "type": "process",
            "command": "ssh",
            "args": [
                "-o",
                "BatchMode=yes",
                "ContainerHost",
                "/usr/local/sbin/scarab-ops backup --instance scarab-test"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "scarabDbHost",
            "type": "promptString",
            "description": "Endereço do host PostgreSQL publicado para a estação Windows",
            "default": "containerhost.hv"
        },
        {
            "id": "scarabDbPort",
            "type": "promptString",
            "description": "Porta PostgreSQL publicada no host",
            "default": "5432"
        }
    ]
}